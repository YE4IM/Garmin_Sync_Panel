GARMIN_SYNC_ROOT=/opt/garmin-sync
GARMIN_SYNC_RUNTIME_DIR=/opt/garmin-sync/runtime
GARMIN_SYNC_PYTHON=/opt/garmin-sync/.venv/bin/python

# Public/default login mode. Generate the password hash with:
# python -m garmin_sync_service.cli hash-password
AUTH_PROVIDER=local
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD_HASH=replace-with-generated-password-hash
LOCAL_AUTH_SESSION_SECRET=replace-with-random-session-secret
LOCAL_AUTH_SESSION_HOURS=12

# Optional WXY LAB Account V1 mode for private deployments.
# Set AUTH_PROVIDER=wxylab and fill these values only on the server that uses it.
ACCOUNT_AUTH_BASE_URL=https://your-account-service.example.com/api/wxylab/account/v1
ACCOUNT_WEB_CLIENT_ID=garmin-sync-web
ACCOUNT_SERVICE_CLIENT_ID=garmin-sync-service
ACCOUNT_CLIENT_SECRET=replace-with-account-client-secret
ACCOUNT_ALLOWED_PHONE=your-phone-number

PUBLIC_BASE_URL=https://your-domain.example.com
COOKIE_SECURE=true

SYNC_ACTIVITY_DAYS=30
SYNC_HEALTH_DAYS=14
DAILY_RUN_TIME=09:40
ENABLE_SCHEDULER=true

# Optional: comma-separated subset of steps for the daily scheduled sync.
# Steps: activity_init, activity_sync, health_sync, activity_export, weight_sync
# Leave empty to run all steps (default).
AUTO_SYNC_STEPS=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_TLS=true
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=Garmin Sync <your-smtp-user@example.com>
SMTP_TO=your-inbox@example.com
MAIL_TO=your-inbox@example.com
MAIL_ATTACHMENT_LIMIT_MB=20

# Outlook/Microsoft Graph OAuth2 sending. Set MAIL_PROVIDER=microsoft_graph
# after registering a Microsoft app with delegated Mail.Send permission.
MAIL_PROVIDER=smtp
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_TENANT_ID=consumers
MICROSOFT_GRAPH_SCOPES=offline_access User.Read Mail.Send

# Optional: Xiaomi MiMo AI trend analysis. Keep the key out of Git.
MIMO_API_KEY=
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5-pro
AI_ANALYSIS_CACHE_HOURS=6
AI_AUTO_ANALYZE_AFTER_SYNC=true
